{
  "rules": {
    "function-no-unknown": [true, { "ignoreFunctions": ["oklch"] }],
    "at-rule-no-unknown": [true, { "ignoreAtRules": ["tailwind", "apply", "variants", "responsive", "screen", "layer", "config", "theme", "plugin", "respond-to"] }],
    "value-keyword-case": [
      "lower",
      {
        "ignoreProperties": ["/^--font-/", "font-family"]
      }
    ]
  }
}
